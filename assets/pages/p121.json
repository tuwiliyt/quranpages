":{"text":"lā","language_name":"english"}},{"id":65154,"position":26,"audio_url":"wbw/005_082_029.mp3","char_type_name":"word","line_number":13,"location":"5:82:26","code_v1":"ﯪ","code_v2":"ﲡ","text_uthmani":"يَسْتَكْبِرُونَ","text_indopak":"يَسۡتَكۡبِرُوۡنَ‏","page_number":121,"text":"ﲡ","translation":{"text":"arrogant","language_name":"english"},"transliteration":{"text":"yastakbirūna","language_name":"english"}},{"id":65155,"position":27,"audio_url":null,"char_type_name":"end","line_number":13,"location":"5:82:27","code_v1":"ﯫ","code_v2":"ﲢ","text_uthmani":"٨٢","text_indopak":"٨٢","page_number":121,"text":"ﲢ","translation":{"text":"(82)","language_name":"english"},"transliteration":{"text":null,"language_name":"english"}}],"audio":{"url":"Alafasy/mp3/005082.mp3","segments":[[0,1,1050,2740],[1,2,2750,3630],[2,3,3640,4890],[3,4,4900,6080],[4,5,6090,7550],[5,6,7560,8350],[6,7,8360,9410],[7,8,9420,10700],[8,9,10710,12320],[9,10,12330,14110],[10,11,14120,16040],[11,12,16050,17020],[12,13,17030,18510],[13,14,18520,19340],[14,15,19350,20400],[15,16,20410,22480],[16,17,22490,24120],[17,18,24130,25800],[18,19,25810,26690],[19,20,26700,28010],[20,21,28020,28940],[21,22,28950,30420],[22,23,30430,31770],[23,24,31780,34450],[24,25,34460,34860],[25,26,34870,37410]]},"translations":[{"id":179743,"resource_id":33,"text":"Pasti akan kamu dapati orang yang paling keras permusuhannya terhadap orang-orang yang beriman, ialah orang-orang Yahudi dan orang-orang musyrik. Dan pasti akan kamu dapati orang yang paling dekat persahabatannya dengan orang-orang yang beriman ialah orang-orang yang berkata, \"Sesungguhnya kami adalah orang Nasrani.\" Yang demikian itu karena di antara mereka terdapat para pendeta dan para rahib, (juga) karena mereka tidak menyombongkan diri."},{"resource_id":999,"language_name":"gorontalo","text":"Delo ta ma odunggaamuma'o ta to'ootutua baalia lio wolo ta hipalasayawa, deuwitoito timongolio ta yahudi wau ta hipopoduulude, wau delo ta ma odunggaamu ma'o ta lebe maahudu waahe'a limongolio wolo ta hipalasayawa de'uwitoito taito timongolio ta hipotoombilua: “tutuulio tutu ami botie Nasara.\" U o'oodito boito tu'udu to woolota limongolio woluo Pandita-pandita wau mongorahibu wau (boli) timongolio diila hipotiti'uda'awa lo batanga limongolio."}]}],"pagination":{"per_page":6,"current_page":1,"next_page":null,"total_pages":1,"total_records":6}}