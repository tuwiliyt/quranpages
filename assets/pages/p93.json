َبِيۡرًا‏","page_number":93,"text":"ﲼ","translation":{"text":"All-Aware","language_name":"english"},"transliteration":{"text":"khabīran","language_name":"english"}},{"id":69358,"position":40,"audio_url":null,"char_type_name":"end","line_number":15,"location":"4:94:40","code_v1":"ﯮ","code_v2":"ﲽ","text_uthmani":"٩٤","text_indopak":"٩٤","page_number":93,"text":"ﲽ","translation":{"text":"(94)","language_name":"english"},"transliteration":{"text":null,"language_name":"english"}}],"audio":{"url":"Alafasy/mp3/004094.mp3","segments":[[0,1,150,2620],[1,2,2630,3570],[2,3,3580,5400],[3,4,5410,5850],[4,5,5860,6810],[5,6,6820,7180],[6,7,7190,8070],[7,8,8080,8730],[8,9,8740,11980],[9,10,11990,12500],[10,11,12510,13580],[11,12,13590,14120],[12,13,14130,16230],[13,14,16240,17150],[14,15,17160,18190],[15,16,18200,18740],[16,17,18750,20080],[17,18,20090,21240],[18,19,21250,21870],[19,20,21880,22880],[20,21,22890,23780],[21,22,23790,25160],[22,23,25170,25960],[23,24,25970,26900],[24,25,26910,28300],[25,26,28310,29270],[26,27,29280,31310],[27,28,31320,32120],[28,29,32130,32790],[29,30,32800,34080],[30,31,34090,34830],[31,32,34840,35890],[32,33,35900,37820],[33,34,37830,39080],[34,35,39090,39870],[35,36,39880,40490],[36,37,40500,41040],[37,38,41050,42240],[38,39,42250,43490]]},"translations":[{"id":179181,"resource_id":33,"text":"Wahai orang-orang yang beriman! Apabila kamu pergi (berperang) di jalan Allah, maka telitilah (carilah keterangan) dan janganlah kamu mengatakan kepada orang yang mengucapkan \"salam\" kepadamu,<sup foot_note=135166>1</sup> \"Kamu bukan seorang yang beriman\", (lalu kamu membunuhnya), dengan maksud mencari harta benda kehidupan dunia, padahal di sisi Allah ada harta yang banyak. Begitu jugalah keadaan kamu dahulu,<sup foot_note=135167>2</sup> lalu Allah memberikan nikmat-Nya kepadamu, maka telitilah! Sungguh, Allah Mahateliti terhadap apa yang kamu kerjakan."},{"resource_id":999,"language_name":"gorontalo","text":"Wuu taito timongolio ta palasaya totonggadu timongoli ma'o motolopaatea to dalalo Eeya yi po'opatatama'olimongoli, wau diilama'o polo'ia timongoli ode ta ma lodaamea wolimongoli yi'o diila waitio lo ta palaaya\" Timongoli hipololohe upango tutumulo dunia, tohuhama lo'u to tili lo Eeya upa-upangala daadaata, u oo'odito boito to oowoluolimongoli to'u muloolio ma yilohiamai lo Allah ni'imati, yi po'opatatama'o olimongoli, tutuulio-tutu Allah labatutu mongotota wolo uma hepohutu-olimongoli."}]}],"pagination":{"per_page":3,"current_page":1,"next_page":null,"total_pages":1,"total_records":3}}