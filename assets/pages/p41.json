],[22,23,24990,25730],[23,24,25740,26080],[24,25,26090,26840],[25,26,26850,27250],[26,27,27260,30060]]},"translations":[{"id":182791,"resource_id":33,"text":"Maka mereka mengalahkannya dengan izin Allah, dan Dawud membunuh Jalut. Kemudian Allah memberinya (Dawud) kerajaan, dan hikmah, dan mengajarinya apa yang Dia kehendaki. Dan kalau Allah tidak melindungi sebagian manusia dengan sebagian yang lain, niscaya rusaklah bumi ini. Tetapi Allah mempunyai karunia (yang dilimpahkan-Nya) atas seluruh alam."},{"resource_id":999,"language_name":"gorontalo","text":"Wau maallaahe limongolio timongolio wolo ijini lo Allah, wau mapilateli Daudate Jaaluta, wau Allah malongohi oli Dauda u'olongia wau hikimati wau ma'ilajarilioma'o tio tomimbihu umaatiliyandahioma'o lo Allah, wau wanu bolo udiila bilubula lo Allah (dindo'o) tauweo ode tauweo, yii malo'andulu tudu lohuta botia. Dabo Allah tahu'uwo lopolutu'o duola to a'alamualo."}]},{"id":259,"verse_number":252,"verse_key":"2:252","hizb_number":4,"rub_el_hizb_number":16,"ruku_number":34,"manzil_number":1,"sajdah_number":null,"chapter_id":2,"page_number":41,"juz_number":2,"words":[{"id":87055,"position":1,"audio_url":"wbw/002_252_001.mp3","char_type_name":"word","line_number":14,"location":"2:252:1","code_v1":"ﯠ","code_v2":"ﲯ","text_uthmani":"تِلْكَ","text_indopak":"تِلۡكَ","page_number":41,"text":"ﲯ","translation":{"text":"These","language_name":"english"},"transliteration":{"text":"til'ka","language_name":"english"}},{"id":87056,"position":2,"audio_url":"wbw/002_252_002.mp3","char_type_name":"word","line_number":14,"location":"2:252:2","code_v1":"ﯡ","code_v2":"ﲰ","text_uthmani":"ءَايَـٰتُ","text_indopak":"اٰيٰتُ","page_number":41,"text":"ﲰ","translation":{"text":"(are the) Verses","language_name":"english"},"transliteration":{"text":"āyātu","language_name":"english"}},{"id":87057,"position":3,"audio_url":"wbw/002_252_003.mp3","char_type_name":"word","line_number":14,"location":"2:252:3","code_v1":"ﯢ","code_v2":"ﲱ","text_uthmani":"ٱل