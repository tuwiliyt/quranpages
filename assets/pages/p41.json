9270,10220],[10,11,10230,10800],[11,12,10810,11280],[12,13,11290,12040],[13,14,12050,13200],[14,15,13210,13520],[15,16,13530,14030],[16,17,14040,14900],[17,18,14910,16500],[18,19,16510,18950],[19,20,18960,19670],[20,21,19680,20080],[21,22,20090,20740],[22,23,20750,22220],[23,24,22230,23370],[24,25,23380,24270],[25,26,24280,24810],[26,27,24820,25450],[27,28,25460,26230],[28,29,26240,28180],[29,30,28190,29520],[30,31,29530,30640],[31,32,30650,31060],[32,33,31070,32090],[33,34,32100,33010],[34,35,33020,33670],[35,36,33680,34490],[36,37,34500,34800],[37,38,34810,35630],[38,39,35640,35940],[39,40,35950,36680],[40,41,36690,37810],[41,42,37820,39240],[42,43,39250,39760],[43,44,39770,40680],[44,45,40690,42510],[45,46,42520,44280],[46,47,44290,44970],[47,48,44980,45670],[48,49,45680,45690],[49,50,45690,47560],[50,51,47570,48920],[51,52,48930,50010],[52,53,50020,50790],[53,54,50800,52050],[54,55,52060,54070],[55,56,54080,54840],[56,57,54850,57540],[57,58,57550,58460],[58,59,58470,58810],[59,60,58820,61170]]},"translations":[{"id":182784,"resource_id":33,"text":"Maka ketika Talut membawa bala tentaranya, dia berkata, \"Allah akan menguji kamu dengan satu sungai. Maka barang siapa meminum (airnya), dia bukanlah pengikutku. Dan barang siapa tidak meminumnya, maka dia adalah pengikutku kecuali menciduk seciduk dengan tangan.\" Tetapi mereka meminumnya kecuali sebagian kecil dari mereka. Ketika dia (Talut) dan orang-orang yang beriman bersamanya menyeberangi sungai itu, mereka berkata, \"Kami tidak kuat lagi pada hari ini melawan Jalut dan bala tentaranya.\" Mereka yang meyakini bahwa mereka akan menemui Allah berkata, \"Betapa banyak kelompok kecil mengalahkan kelompok besar dengan izin Allah.\" Dan Allah beserta orang-orang yang sabar.\""},{"resource_id":999,"language_name":"gorontalo","text":"Tondahu umaa lodelomai ti Thaaluta bala tentara lio malolo'ia tio tutulio-tutu Allah mohimondala olimongoli lodutula, tita-lotita ta yilongilu taluhu dutula boito, yii tio diila waitu'u, wau tita-lotita taa diila longilu taluhe boito ngopohia talolalu'ai ngotalu'o olu'ulio, yii tutuliotutu tio boito waitu'u. Yii matilonggoyilu timongolio ngopohia ngo'idi limongolio dila longilu. Tondahu umaalobalanga'o tio (to dutula) boito wau taa palasaya wolio, lolo'ia timongolio ami botia dila mo'owali todulahe botiya mopatea wole Jaaluta wolo bala tentara lio, lolo'ia taito timongolio taa yakini tutuliotutu timongolio modudunggaya lo Allah: maatima'o lembo'a ngo'idi mo'olaahe lembo'a dadaata wolo ijini lo Allah, wau Allah wolo taa hisabaria."}]},{"id":257,"verse_number":250,"verse_key":"2:250","hizb_number":4,"rub_el_hizb_number":16,"ruku_number":34,"manzil_number":1,"sajdah_number":null,"chapter_id":2,"page_number":41,"juz_number":2,"words":[{"id":87010,"position":1,"audio_url":"wbw/002_250_001.mp3","char_type_name":"word","line_number":8,"location":"2:250:1","code_v1":"ﮒ","code_v2":"ﲂ","text_uthmani":"وَلَمَّا","text_indopak":"وَلَمَّا","page_number":41,"text":"ﲂ","translation":{"text":"And when","language_name":"english"},"transliteration":{"text":"walammā","language_name":"english"}},{"id":87011,"position":2,"audio_url":"wbw/002_250_002.mp3","char_type_name":"word","line_number":8,"location":"2:250:2","code_v1":"ﮓ","code_v2":"ﲃ","text_uthmani":"بَرَزُوا۟","text_indopak":"بَرَزُوۡا","page_number":41,"text":"ﲃ","translation":{"text":"they went forth","language_name":"english"},"transliteration":{"text":"barazū","language_name":"english"}},{"id":87012,"position":3,"audio_url":"wbw/002_250_003.mp3","char_type_name":"word","line_number":8,"location":"2:250:3","code_v1":"ﮔ","code_v2":"ﲄ","text_uthmani":"لِجَالُوتَ","text_indopak":"لِجَـالُوۡتَ","page_number":41,"text":"ﲄ","translation":{"text":"to (face) Jalut","language_name":"english"},"transliteration":{"text":"lijālūta","language_name":"english"}},{"id":87013,"position":4,"audio_url":"wbw/002_250_004.mp3","char_type_name":"word","line_number":8,"location":"2:250:4","code_v1":"ﮕ","code_v2":"ﲅ","text_uthmani":"و