":[{"id":178868,"resource_id":33,"text":"Dan jika kamu khawatir terjadi persengketaan antara keduanya, maka kirimlah seorang juru damai dari keluarga laki-laki dan seorang juru damai dari keluarga perempuan. Jika keduanya (juru damai itu) bermaksud mengadakan perbaikan, niscaya Allah memberi taufik kepada suami-istri itu. Sungguh, Allah Maha Mengetahui, Mahateliti."},{"resource_id":999,"language_name":"gorontalo","text":"Wanu bolo timongoli hawaatiri lo'u butula'o to woolota mongolio duulota (motolodile) yi ahuli mota limongoli ta ngota montho ongongaala'a lo talola'i wau ngota montho ongongaala'a lo taabua taa mopodutu lo buto'o, wanu timongolio duulota o patuju mopopiiyohu (taa mopodutu lo buto'o) yio ma yilohiamai lo Allah potunu timongolio duulota. Tutuu lio tutu Allah motota wau motulete."}]},{"id":529,"verse_number":36,"verse_key":"4:36","hizb_number":9,"rub_el_hizb_number":34,"ruku_number":67,"manzil_number":1,"sajdah_number":null,"chapter_id":4,"page_number":84,"juz_number":5,"words":[{"id":37800,"position":1,"audio_url":"wbw/004_036_002.mp3","char_type_name":"word","line_number":9,"location":"4:36:1","code_v1":"ﮖ ﮗ","code_v2":"ﲆ ﲇ","text_uthmani":"۞ وَٱعْبُدُوا۟","text_indopak":"۞ وَاعۡبُدُوا","page_number":84,"text":"ﲆ ﲇ","translation":{"text":"And worship","language_name":"english"},"transliteration":{"text":"wa-uʿ'budū","language_name":"english"}},{"id":37801,"position":2,"audio_url":"wbw/004_036_003.mp3","char_type_name":"word","line_number":9,"location":"4:36:2","code_v1":"ﮘ","code_v2":"ﲈ","text_uthmani":"ٱللَّهَ","text_indopak":"اللّٰهَ","page_number":84,"text":"ﲈ","translation":{"text":"Allah","language_name":"english"},"transliteration":{"text":"l-laha","language_name":"english"}},{"id":37802,"position":3,"audio_url":"wbw/004_036_004.mp3","char_type_name":"word","line_number":9,"location":"4:36:3","code_v1":"ﮙ","code_v2":"ﲉ","text_uthmani":"وَلَا","text_indopak":"وَلَا","page_number":84,"text":"ﲉ","translation":{"text":"And (do) not","language_name"