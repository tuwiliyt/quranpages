xt_indopak":"عَلِيًّا","page_number":84,"text":"ﱫ","translation":{"text":"Most High","language_name":"english"},"transliteration":{"text":"ʿaliyyan","language_name":"english"}},{"id":36413,"position":40,"audio_url":"wbw/004_034_044.mp3","char_type_name":"word","line_number":6,"location":"4:34:40","code_v1":"ﭼ","code_v2":"ﱬ","text_uthmani":"كَبِيرًۭا","text_indopak":"كَبِيۡرًا‏ ﻿﻿","page_number":84,"text":"ﱬ","translation":{"text":"Most Great","language_name":"english"},"transliteration":{"text":"kabīran","language_name":"english"}},{"id":36414,"position":41,"audio_url":null,"char_type_name":"end","line_number":6,"location":"4:34:41","code_v1":"ﭽ","code_v2":"ﱭ","text_uthmani":"٣٤","text_indopak":"٣٤","page_number":84,"text":"ﱭ","translation":{"text":"(34)","language_name":"english"},"transliteration":{"text":null,"language_name":"english"}}],"audio":{"url":"Alafasy/mp3/004034.mp3","segments":[[0,1,110,1350],[1,2,1360,2870],[2,3,2880,3380],[3,4,3390,6170],[4,5,6180,6740],[5,6,6750,7580],[6,7,7590,8450],[7,8,8460,9480],[8,9,9490,10150],[9,10,10160,10890],[10,11,10900,13260],[11,12,13270,15060],[12,13,15070,15440],[13,14,15450,17200],[14,15,17210,18850],[15,16,18860,20290],[16,17,20300,21670],[17,18,21680,22850],[18,19,22860,23420],[19,20,23430,26160],[20,21,26170,26590],[21,22,26600,27830],[22,23,27840,29110],[23,24,29120,30840],[24,25,30850,32910],[25,26,32920,34920],[26,27,34930,35150],[27,28,35160,36450],[28,29,36460,39250],[29,30,39260,39850],[30,31,39860,41180],[31,32,41190,41730],[32,33,41740,42550],[33,34,42560,44610],[34,35,44620,46220],[35,36,46230,47560],[36,37,47570,48400],[37,38,48410,49020],[38,39,49030,50610],[39,40,50620,51880]]},"translations":[{"id":178856,"resource_id":33,"text":"Laki-laki (suami) itu pelindung bagi perempuan (istri), karena Allah telah melebihkan sebagian mereka (laki-laki) atas sebagian yang lain (perempuan), dan karena mereka (laki-laki) telah memberikan nafkah dari hartanya. Maka perempuan-perempuan yang saleh, adalah mereka yang taat (kepada Allah) dan menjaga diri ketika (suaminya) tidak ada, karena Allah telah menjaga (mereka).<sup foot_note=135142>1</sup> Perempuan-perempuan yang kamu khawatirkan akan nusyuz,<sup foot_note=135143>2</sup> hendaklah kamu beri nasihat kepada mereka, tinggalkanlah mereka di tempat tidur (pisah ranjang), dan (kalau perlu) pukullah mereka. Tetapi jika mereka menaatimu, maka janganlah kamu mencari-cari alasan untuk menyusahkannya. Sungguh, Allah Mahatinggi, Mahabesar."},{"resource_id":999,"language_name":"gorontalo","text":"Mongolola'i taa hi'oluhula to mongobua lo toonula u maa pilopolebe mai lo Allahuta'ala olimongolio (mongolola'i) du'-olaa olimongolio (mongobua), wau saba-sababu timongolio (mongolola'i) taa hipongohia balanja to (mongobua). Mongobua ta saalehe de uitoyito taa ta'ati wau hemodaha batanga limongolio to'u dile limongolio dialuo. Wau mongobua ta hemo'ohawatiri olimongoli (mongolala'i) nusyusuz limo-ngolio (mongobua) yi nasihatii ma'o limongoli timongolio wau bu'awa ma'o limongoli timongolio to pottuluhe wau wumbadi ma'o limongoli timongolio. Wanu timongolio mamodungohe olimongoli didu maa hepolo-pololohi limongoli totala ueewo. Tutuu lio tutu Allah ta molanggata boli uda'a."}]},{"id":528,"verse_number":35,"verse_key":"4:35","hizb_number":9,"rub_el_hizb_number":33,"ruku_number":67,"manzil_number":1,"sajdah_number":null,"chapter_id":4,"page_number":84,"juz_number":5,"words":[{"id":36976,"position":1,"audio_url":"wbw/004_035_001.mp3","char_type_name":"word","line_number":6,"location":"4:35:1","code_v1":"ﭾ","code_v2":"ﱮ","text_uthmani":"وَإِنْ","text_indopak":"وَاِنۡ","page_number":84,"text":"ﱮ","translation":{"text":"And if","language_name":"english"},"transliteration":{"text":"wa-in","language_name":"english"}},{"id":36977,"position":2,"audio_url":"wbw/004_035_002.mp3","char_type_name":"word","line_number":6,"location":"4:35:2","code_v1":"ﭿ","code_v2":"ﱯ","text_uthmani":"خِفْتُمْ","text_indopak":"خِفۡتُمۡ","page_number":84,"text":"ﱯ","translation