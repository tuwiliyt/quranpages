lio diila mo'owali mohehuma'o u mondo lango boito. Tutuuwawuwa lupuhio lo ta hemolubo wau ta hetuboolo."}]},{"id":2669,"verse_number":74,"verse_key":"22:74","hizb_number":34,"rub_el_hizb_number":136,"ruku_number":294,"manzil_number":4,"sajdah_number":null,"chapter_id":22,"page_number":341,"juz_number":17,"words":[{"id":61760,"position":1,"audio_url":"wbw/022_074_001.mp3","char_type_name":"word","line_number":4,"location":"22:74:1","code_v1":"ﭱ","code_v2":"ﱡ","text_uthmani":"مَا","text_indopak":"مَا","page_number":341,"text":"ﱡ","translation":{"text":"Not","language_name":"english"},"transliteration":{"text":"mā","language_name":"english"}},{"id":61761,"position":2,"audio_url":"wbw/022_074_002.mp3","char_type_name":"word","line_number":4,"location":"22:74:2","code_v1":"ﭲ","code_v2":"ﱢ","text_uthmani":"قَدَرُوا۟","text_indopak":"قَدَرُوا","page_number":341,"text":"ﱢ","translation":{"text":"they (have) estimated","language_name":"english"},"transliteration":{"text":"qadarū","language_name":"english"}},{"id":61762,"position":3,"audio_url":"wbw/022_074_003.mp3","char_type_name":"word","line_number":4,"location":"22:74:3","code_v1":"ﭳ","code_v2":"ﱣ","text_uthmani":"ٱللَّهَ","text_indopak":"اللّٰهَ","page_number":341,"text":"ﱣ","translation":{"text":"Allah","language_name":"english"},"transliteration":{"text":"l-laha","language_name":"english"}},{"id":61763,"position":4,"audio_url":"wbw/022_074_004.mp3","char_type_name":"word","line_number":4,"location":"22:74:4","code_v1":"ﭴ","code_v2":"ﱤ","text_uthmani":"حَقَّ","text_indopak":"حَقَّ","page_number":341,"text":"ﱤ","translation":{"text":"(with) due","language_name":"english"},"transliteration":{"text":"ḥaqqa","language_name":"english"}},{"id":61764,"position":5,"audio_url":"wbw/022_074_005.mp3","char_type_name":"word","line_number":4,"location":"22:74:5","code_v1":"ﭵﭶ","code_v2":"ﱥﱦ","text_uthmani":"قَدْرِهِۦٓ ۗ","text_indopak":"قَدۡرِهٖؕ","page_number":341,"text":"ﱥﱦ","translation":{"text":"[His] estimation","language_name