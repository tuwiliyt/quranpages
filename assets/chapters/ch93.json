"english"}, "transliteration": {"text": "fatarḍā", "language_name": "english"}}, {"id": 4818, "position": 5, "audio_url": null, "char_type_name": "end", "line_number": 10, "location": "93:5:5", "code_v1": "ﮈ", "code_v2": "ﲏ", "text_uthmani": "٥", "text_indopak": "٥", "page_number": 596, "text": "ﲏ", "translation": {"text": "(5)", "language_name": "english"}, "transliteration": {"text": null, "language_name": "english"}}], "translations": [{"id": 181197, "resource_id": 33, "text": "Dan sungguh, kelak Tuhanmu pasti memberikan karunia-Nya kepadamu, sehingga engkau menjadi puas."}]}, {"id": 6085, "verse_number": 6, "verse_key": "93:6", "hizb_number": 60, "rub_el_hizb_number": 238, "ruku_number": 537, "manzil_number": 7, "sajdah_number": null, "chapter_id": 93, "page_number": 596, "juz_number": 30, "words": [{"id": 5889, "position": 1, "audio_url": "wbw/093_006_001.mp3", "char_type_name": "word", "line_number": 10, "location": "93:6:1", "code_v1": "ﮉ", "code_v2": "ﲐ", "text_uthmani": "أَلَمْ", "text_indopak": "اَلَمۡ", "page_number": 596, "text": "ﲐ", "translation": {"text": "Did not", "language_name": "english"}, "transliteration": {"text": "alam", "language_name": "english"}}, {"id": 5890, "position": 2, "audio_url": "wbw/093_006_002.mp3", "char_type_name": "word", "line_number": 10, "location": "93:6:2", "code_v1": "ﮊ", "code_v2": "ﲑ", "text_uthmani": "يَجِدْكَ", "text_indopak": "يَجِدۡكَ", "page_number": 596, "text": "ﲑ", "translation": {"text": "He find you", "language_name": "english"}, "transliteration": {"text": "yajid'ka", "language_name": "english"}}, {"id": 5891, "position": 3, "audio_url": "wbw/093_006_003.mp3", "char_type_name": "word", "line_number": 10, "location": "93:6:3", "code_v1": "ﮋ", "code_v2": "ﲒ", "text_uthmani": "يَتِيمًۭا", "text_indopak": "يَتِيۡمًا", "page_number": 596, "text": "ﲒ", "translation": {"text": "an orphan", "language_name": "english"}, "transliteration": {"text": "yatīman", "language_name": "english"}}, {"id": 5892, "position": 4, 